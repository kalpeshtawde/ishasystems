# Zoho SMTP credentials for the contact form (used by backend/app.py)
# Create a real .env from this file on the server. Never commit real values.

# Zoho SMTP host. Use smtp.zoho.com (US) or smtp.zoho.eu / smtp.zoho.in for your region.
SMTP_HOST=smtp.zoho.com
# 587 for STARTTLS (used by the backend)
SMTP_PORT=587
# The full Zoho mailbox you authenticate with (must be a real mailbox on your domain)
SMTP_USER=support@ishasystems.com
# An app-specific password generated in Zoho (Account > Security > App Passwords)
SMTP_PASS=your-zoho-app-password

# Email Configuration
EMAIL_FROM=support@ishasystems.com
EMAIL_TO=support@ishasystems.com

# Backend server port
PORT=5000
